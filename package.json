{
  "name": "folden",
  "private": true,
  "version": "0.4.2",
  "description": "Local-first desktop Markdown and text editor.",
  "author": "byrnane",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git@github.com:byrnane/folden.git"
  },
  "type": "module",
  "scripts": {
    "app:dev": "node scripts/tauri.mjs dev",
    "app:build": "node scripts/tauri.mjs build --no-bundle",
    "app:run": "node scripts/run-app.mjs",
    "vue:dev": "vite",
    "vue:typecheck": "vue-tsc --noEmit",
    "vue:build": "npm run vue:typecheck && vite build",
    "vue:preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "codemirror": "^6.0.2",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
