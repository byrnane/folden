{
  "name": "folden",
  "private": true,
  "version": "0.12.0",
  "description": "Desktop Markdown and text editor with visual and source modes.",
  "author": "byrnane",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/byrnane/folden",
  "bugs": "https://github.com/byrnane/folden/issues",
  "engines": {
    "node": "24.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/byrnane/folden.git"
  },
  "type": "module",
  "scripts": {
    "quality": "npm run version:check && npm run format:check && npm run vue:typecheck && npm run vue:unused && npm run deps:cycles && npm run lint && npm run test:unit",
    "app:dev": "node scripts/tauri.mjs dev --config src-tauri/tauri.dev.conf.json",
    "app:build": "node scripts/tauri.mjs build --no-bundle",
    "app:run": "node scripts/run-app.mjs",
    "vue:dev": "vite",
    "vue:typecheck": "vue-tsc --noEmit",
    "vue:unused": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "vue:build": "npm run vue:typecheck && vite build",
    "vue:preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/check-version.mjs",
    "licenses:generate": "node scripts/third-party-notices.mjs",
    "licenses:check": "node scripts/third-party-notices.mjs --check",
    "privacy:check": "node scripts/privacy-check.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:release": "node scripts/release-self-check.mjs",
    "deps:cycles": "node scripts/check-dependency-cycles.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:headed": "node scripts/run-e2e.mjs --headed",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:performance": "node scripts/run-performance.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "codemirror": "^6.0.2",
    "lucide-vue-next": "^1.0.0",
    "marked": "^17.0.6",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
