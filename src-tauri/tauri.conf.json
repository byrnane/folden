{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folden",
  "version": "0.12.0",
  "identifier": "com.folden.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vue:dev",
    "beforeBuildCommand": "npm run vue:build"
  },
  "app": {
    "windows": [
      {
        "title": "Folden",
        "theme": "Dark",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset: http://asset.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "folden",
    "licenseFile": "../LICENSE.md",
    "resources": {
      "../LICENSE.md": "LICENSE.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
